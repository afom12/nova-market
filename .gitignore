# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment — never commit secrets
.env
.env.*
!.env.example
# Exception: server/.env.test holds only deliberately fake values (a dummy
# JWT secret, a dummy Stripe webhook secret used for local HMAC signing, and
# a localhost test database). It is committed so `npm test` works on a fresh
# clone. Never put a real credential in it.
!server/.env.test
*.pem
*.key

