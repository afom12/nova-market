###############################################################################
# NOVA MARKET — environment template
#
# Copy to server/.env (and adjust) before running the API:
#   cp .env.example server/.env
#
# NEVER commit a real .env file. Only test-mode Stripe keys are used in this
# project; a live key (sk_live_...) must never appear here.
###############################################################################

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Database
# With docker compose, host is `postgres`; running locally it is `localhost`.
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://nova:nova_password@localhost:5432/nova_market?schema=public"

# ----------------------------------------------------------------------------
# Authentication
# Generate a strong secret:  openssl rand -base64 48
# ----------------------------------------------------------------------------
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d
COOKIE_NAME=nova_token
CSRF_COOKIE_NAME=nova_csrf
# 'lax' keeps the session alive across the Stripe redirect back to the app.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# ----------------------------------------------------------------------------
# Stripe — TEST MODE ONLY
# Secret key:      https://dashboard.stripe.com/test/apikeys
# Webhook secret:  printed by `stripe listen --forward-to ...` as whsec_...
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_replace_with_your_test_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_webhook_signing_secret"
STRIPE_CURRENCY=usd

# ----------------------------------------------------------------------------
# Frontend / CORS
# ----------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ----------------------------------------------------------------------------
# Seed accounts (development only — change before any real deployment)
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@novamarket.test
SEED_ADMIN_PASSWORD=Admin123!change
SEED_ADMIN_NAME=Nova Admin
SEED_CUSTOMER_EMAIL=customer@novamarket.test
SEED_CUSTOMER_PASSWORD=Customer123!

###############################################################################
# Frontend (client/.env) — Vite only exposes VITE_* variables to the browser.
# Never put a Stripe SECRET key here; the client needs no Stripe key at all,
# because checkout is created server-side and the customer is redirected.
###############################################################################
# VITE_API_URL=http://localhost:4000/api
