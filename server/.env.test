# Test environment. Points at a SEPARATE database so running the suite can
# never touch development data. Values here are deliberately fake.
NODE_ENV=test
PORT=4100
LOG_LEVEL=silent

DATABASE_URL="postgresql://postgres:2116102410@localhost:5432/nova_market_test?schema=public"
JWT_SECRET="test-environment-jwt-secret-value-0123456789abcdef"
JWT_EXPIRES_IN=1h
COOKIE_NAME=nova_token
CSRF_COOKIE_NAME=nova_csrf
COOKIE_SAME_SITE=lax

# Not real credentials. The Stripe SDK is stubbed for outbound calls; the
# webhook secret below is used to generate and verify REAL HMAC signatures
# locally, which is pure crypto and needs no network access.
STRIPE_SECRET_KEY="sk_test_00000000000000000000000000"
STRIPE_WEBHOOK_SECRET="whsec_test_secret_for_signature_verification"
STRIPE_CURRENCY=usd

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
